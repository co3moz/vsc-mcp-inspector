{
  "name": "vsc-mcp-inspector",
  "displayName": "MCP Server Inspector",
  "description": "Connect to Model Context Protocol servers over stdio, SSE or Streamable HTTP, browse their tools, prompts and resources, and invoke them from VS Code.",
  "version": "0.1.4",
  "publisher": "co3moz",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/co3moz/vsc-mcp-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/co3moz/vsc-mcp-inspector/issues"
  },
  "homepage": "https://github.com/co3moz/vsc-mcp-inspector#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "inspector",
    "ai",
    "tools"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpInspector",
          "title": "MCP Inspector",
          "icon": "resources/mcp-inspector.svg"
        }
      ]
    },
    "views": {
      "mcpInspector": [
        {
          "id": "mcpInspector.connections",
          "name": "Connections",
          "icon": "resources/mcp-inspector.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mcpInspector.connections",
        "contents": "No MCP connections yet.\n[Create New Connection](command:mcpInspector.createConnection)\nConnect to an MCP server over stdio, SSE or Streamable HTTP to browse and invoke its tools."
      }
    ],
    "commands": [
      {
        "command": "mcpInspector.createConnection",
        "title": "Create New Connection",
        "category": "MCP Inspector",
        "icon": "$(add)"
      },
      {
        "command": "mcpInspector.editConnection",
        "title": "Edit Connection",
        "category": "MCP Inspector",
        "icon": "$(edit)"
      },
      {
        "command": "mcpInspector.deleteConnection",
        "title": "Delete Connection",
        "category": "MCP Inspector",
        "icon": "$(trash)"
      },
      {
        "command": "mcpInspector.connect",
        "title": "Connect",
        "category": "MCP Inspector",
        "icon": "$(plug)"
      },
      {
        "command": "mcpInspector.disconnect",
        "title": "Disconnect",
        "category": "MCP Inspector",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mcpInspector.reconnect",
        "title": "Reconnect",
        "category": "MCP Inspector",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mcpInspector.refresh",
        "title": "Refresh",
        "category": "MCP Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "mcpInspector.showServerInfo",
        "title": "Show Server Info",
        "category": "MCP Inspector",
        "icon": "$(info)"
      },
      {
        "command": "mcpInspector.showLogs",
        "title": "Show Logs",
        "category": "MCP Inspector",
        "icon": "$(output)"
      },
      {
        "command": "mcpInspector.search",
        "title": "Search",
        "category": "MCP Inspector",
        "icon": "$(search)"
      },
      {
        "command": "mcpInspector.clearSearch",
        "title": "Clear Search",
        "category": "MCP Inspector",
        "icon": "$(clear-all)"
      },
      {
        "command": "mcpInspector.sort",
        "title": "Change Sort Order",
        "category": "MCP Inspector",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "mcpInspector.openItem",
        "title": "Open",
        "category": "MCP Inspector"
      },
      {
        "command": "mcpInspector.runItem",
        "title": "Run",
        "category": "MCP Inspector",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mcpInspector.openItem",
          "when": "false"
        },
        {
          "command": "mcpInspector.runItem",
          "when": "false"
        },
        {
          "command": "mcpInspector.clearSearch",
          "when": "mcpInspector.searching"
        }
      ],
      "view/title": [
        {
          "command": "mcpInspector.createConnection",
          "when": "view == mcpInspector.connections",
          "group": "navigation@1"
        },
        {
          "command": "mcpInspector.search",
          "when": "view == mcpInspector.connections",
          "group": "navigation@2"
        },
        {
          "command": "mcpInspector.clearSearch",
          "when": "view == mcpInspector.connections && mcpInspector.searching",
          "group": "navigation@3"
        },
        {
          "command": "mcpInspector.sort",
          "when": "view == mcpInspector.connections",
          "group": "navigation@4"
        },
        {
          "command": "mcpInspector.refresh",
          "when": "view == mcpInspector.connections",
          "group": "navigation@5"
        },
        {
          "command": "mcpInspector.showLogs",
          "when": "view == mcpInspector.connections",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "mcpInspector.connect",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-(idle|disconnected|error)$/",
          "group": "inline@1"
        },
        {
          "command": "mcpInspector.refresh",
          "when": "view == mcpInspector.connections && viewItem == connection-connected",
          "group": "inline@1"
        },
        {
          "command": "mcpInspector.disconnect",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-(connected|connecting)$/",
          "group": "inline@2"
        },
        {
          "command": "mcpInspector.editConnection",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-/",
          "group": "inline@3"
        },
        {
          "command": "mcpInspector.connect",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-(idle|disconnected|error)$/",
          "group": "1_connection@1"
        },
        {
          "command": "mcpInspector.reconnect",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-(connected|error)$/",
          "group": "1_connection@2"
        },
        {
          "command": "mcpInspector.disconnect",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-(connected|connecting)$/",
          "group": "1_connection@3"
        },
        {
          "command": "mcpInspector.showServerInfo",
          "when": "view == mcpInspector.connections && viewItem == connection-connected",
          "group": "2_info@1"
        },
        {
          "command": "mcpInspector.editConnection",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-/",
          "group": "3_edit@1"
        },
        {
          "command": "mcpInspector.deleteConnection",
          "when": "view == mcpInspector.connections && viewItem =~ /^connection-/",
          "group": "3_edit@2"
        },
        {
          "command": "mcpInspector.runItem",
          "when": "view == mcpInspector.connections && viewItem =~ /^(tool|prompt|resource|template)$/",
          "group": "inline@1"
        },
        {
          "command": "mcpInspector.openItem",
          "when": "view == mcpInspector.connections && viewItem =~ /^(tool|prompt|resource|template)$/",
          "group": "1_item@1"
        },
        {
          "command": "mcpInspector.runItem",
          "when": "view == mcpInspector.connections && viewItem =~ /^(tool|prompt|resource|template)$/",
          "group": "1_item@2"
        }
      ]
    },
    "configuration": {
      "title": "MCP Inspector",
      "properties": {
        "mcpInspector.requestTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "markdownDescription": "Timeout in seconds for connecting and for each MCP request. Progress notifications from the server reset the timer."
        },
        "mcpInspector.logTraffic": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Log every JSON-RPC message exchanged with servers to the **MCP Inspector** output channel."
        },
        "mcpInspector.sortOrder": {
          "type": "string",
          "enum": [
            "none",
            "ascending",
            "descending"
          ],
          "enumDescriptions": [
            "The order the server lists them in.",
            "By name, A to Z.",
            "By name, Z to A."
          ],
          "default": "none",
          "markdownDescription": "Order of the tools, prompts, resources and resource templates under each connection in the **Connections** view."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run test:core && npm run test:integration",
    "test:core": "node test/run-core.mjs",
    "test:integration": "node test/run-integration.mjs",
    "test-server": "node test/server.mjs http 3001",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
