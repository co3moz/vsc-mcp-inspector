{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$esbuild"
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch"
    },
    {
      "label": "Test server (HTTP + SSE on :3001)",
      "type": "shell",
      "command": "node test/server.mjs http 3001",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
